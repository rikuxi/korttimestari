{
  "name": "korttimestari",
  "version": "1.0.0",
  "description": "Texas Hold'em-, Omaha- ja Omaha5-voittotodennäköisyyksien Monte Carlo -simulaattori ja preflop-rankingit / Monte Carlo poker odds simulator and preflop rankings",
  "license": "MIT",
  "author": "Riku",
  "repository": {
    "type": "git",
    "url": "https://github.com/rikuxi/korttimestari.git"
  },
  "private": true,
  "engines": {
    "node": ">=18.14"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
